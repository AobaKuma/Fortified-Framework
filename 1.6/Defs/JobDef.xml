<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorkGiverDef>
    <defName>FFF_DoAutonomousBill</defName>
    <label>make things</label>
    <giverClass>Fortified.WorkGiver_DoAutonomousBill</giverClass>
    <workType>Smithing</workType>
    <priorityInType>210</priorityInType>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <JobDef>
    <defName>FFF_DoAutonomousBill</defName>
    <driverClass>Fortified.JobDriver_DoAutonomousBill</driverClass>
    <reportString>working.</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_FinishAutonomousBill</defName>
    <driverClass>Fortified.JobDriver_FinishAutonomousBill</driverClass>
    <reportString>working.</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_EquipDeployable</defName>
    <driverClass>Fortified.JobDriver_EquipDeployable</driverClass>
    <reportString>equipping TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>FFF_RepairSelf</defName>
    <driverClass>Fortified.JobDriver_RepairSelf</driverClass>
    <reportString>repairing TargetA.</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_MechLeave</defName>
    <driverClass>Fortified.JobDriver_MechLeave</driverClass>
    <reportString>leaving.</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_EnterBunkerFacility</defName>
    <driverClass>Fortified.JobDriver_EnterBunkerFacility</driverClass>
    <reportString>entering facility</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <joyDuration>250</joyDuration>
  </JobDef>

  <JobDef>
    <defName>FFF_ReturnToDronePlatform</defName>
    <driverClass>Fortified.JobDriver_ReturnToPlatform</driverClass>
    <reportString>returning to platform</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
    <forceCompleteBeforeNextJob>true</forceCompleteBeforeNextJob>
  </JobDef>

  <JobDef>
    <defName>FFF_Modification</defName>
    <driverClass>Fortified.JobDriver_ApplyModification</driverClass>
    <reportString>modifying TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>FFF_ModificationRemove</defName>
    <driverClass>Fortified.JobDriver_RemoveModification</driverClass>
    <reportString>removing modification from TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>FFF_EjectDeactivatedMech</defName>
    <reportString>disabling mech</reportString>
    <driverClass>Fortified.JobDriver_DisableMech</driverClass>
  </JobDef>

  <JobDef>
    <defName>FFF_HackDeactivatedMech</defName>
    <reportString>hacking mech</reportString>
    <driverClass>Fortified.JobDriver_OpenMech</driverClass>
  </JobDef>

  <JobDef>
    <defName>FFF_ResurrectMech</defName>
    <driverClass>Fortified.JobDriver_ResurrectMech</driverClass>
    <reportString>rebooting TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>FFF_Replenish</defName>
    <driverClass>Fortified.JobDriver_Replenish</driverClass>
    <reportString>Replenishing</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_SwitchAmmo</defName>
    <driverClass>Fortified.JobDriver_SwitchAmmo</driverClass>
    <reportString>Switching ammo</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_EquipTurret</defName>
    <driverClass>Fortified.JobDriver_EquipTurret</driverClass>
    <reportString>Equiping turret</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_UseAccessKey</defName>
    <driverClass>Fortified.JobDriver_UseAccessKey</driverClass>
    <reportString>activating TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>FFF_ControlMech_Overseer</defName>
    <driverClass>Fortified.JobDriver_ControlMech_Overseer</driverClass>
    <reportString>taking control of TargetA.</reportString>
  </JobDef>

  <JobDef>
    <defName>FFF_RepairMech_Overseer</defName>
    <driverClass>Fortified.JobDriver_RepairMech_Overseer</driverClass>
    <reportString>repairing TargetA.</reportString>
  </JobDef>

  <!-- 設施封鎖：從地表對入口執行緊急解鎖（Fortified.CompFacilityLockdownGate）。
       Facility lockdown: emergency override on the entrance from the surface. -->
  <JobDef>
    <defName>FFF_LockdownOverride</defName>
    <driverClass>Fortified.JobDriver_LockdownOverride</driverClass>
    <reportString>overriding the lockdown on TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
